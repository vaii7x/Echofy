    def _send_file_over_conn(self, filepath):
        if not self.conn:
            self._ui_log(
                "[Not connected to a peer — cannot send file]"
            )
            return

        try:
            with open(filepath, "rb") as f:
                data = f.read()
        except Exception as e:
            self._ui_log(
                f"[Send file error] Could not read file: {e}"
            )
            return

        filename = os.path.basename(filepath).replace(
            "|",
            "_"
        )

        size = len(data)

        header = (
            f"FILE|{filename}|{size}\n"
        ).encode("utf-8")

        try:
            with self.conn_lock:
                self.conn.sendall(header)

                sent = 0
                CH = 4096

                while sent < size:
                    chunk = data[sent:sent + CH]
                    self.conn.sendall(chunk)
                    sent += len(chunk)

            self._ui_log(
                f"[Photo sent: {filename} ({size} bytes)]"
            )
        except Exception as e:
            self._ui_log(
                f"[Send file error] {e}"
            )
            self._handle_disconnect_and_reconnect()

    def _ask_echofi_about_photo(self):
        target = None

        if (
            self.last_received_photo
            and os.path.isfile(self.last_received_photo)
        ):
            target = self.last_received_photo
        elif (
            self.last_taken_photo
            and os.path.isfile(self.last_taken_photo)
        ):
            target = self.last_taken_photo
        else:
            file = filedialog.askopenfilename(
                title="Select image to ask about",
                filetypes=[
                    (
                        "Images",
                        "*.png;*.jpg;*.jpeg;*.bmp"
                    ),
                    (
                        "All files",
                        "*.*"
                    )
                ]
            )

            if not file:
                return

            target = file

        if not target:
            self._ui_log(
                "[No photo available to ask about]"
            )
            return

        if genai is None or not API_KEY:
            self._ui_log(
                "[Echofi AI not configured — cannot analyze image]"
            )

            messagebox.showinfo(
                "Echofi AI not available",
                "Echofi AI not configured or "
                "google-generativeai not installed."
            )

            return

        try:
            with open(target, "rb") as f:
                b = f.read()

            b64 = base64.b64encode(b).decode(
                "ascii"
            )
        except Exception as e:
            self._ui_log(
                f"[Photo read error] {e}"
            )
            return

        self._ui_log(
            "[Asking Echofi about photo — this may take a moment]"
        )

        self._set_status(
            "🤖 Echofi analyzing image..."
        )

        def _ask():
            try:
                prompt = (
                    "Please analyze the following image (base64). "
                    "Summarize the scene, "
                    "list main objects, detect text if any, "
                    "and give suggestions."
                    "\n\nBASE64_IMAGE_START\n"
                    + b64 +
                    "\nBASE64_IMAGE_END"
                )

                wrapper = EchofiAI(
                    API_KEY,
                    ECHOFI_MODEL
                )

                reply = wrapper.reply(prompt)

            except Exception as e:
                reply = f"[Echofi AI error] {e}"

            self.last_ai_reply = reply

            self._ui_log(
                "Echofi: " + reply
            )

            self._set_status(
                "🤖 Echofi ready"
            )

            if self.voice and self.voice.tts:
                try:
                    self.voice.speak_async(reply)
                except Exception:
                    pass

        thread(_ask)

    def _maybe_send_typing(self):
        if self.conn:
            def _send():
                try:
                    with self.conn_lock:
                        if self.conn:
                            self.conn.sendall(
                                b"__typing__"
                            )
                except Exception:
                    pass

            thread(_send)

    def _on_send(self):
        text = self.entry.get().strip()

        if not text:
            return

        self.entry.delete(
            0,
            "end"
        )

        self._ui_log(
            "You: " + text
        )

        if self.conn:
            try:
                with self.conn_lock:
                    self.conn.sendall(
                        text.encode("utf-8")
                    )
            except Exception as e:
                self._ui_log(
                    f"[Send failed] {e}"
                )
                self._handle_disconnect_and_reconnect()
        else:
            if self.echofi_ai:
                self._set_status(
                    "🤖 Echofi thinking..."
                )

                def _ask():
                    try:
                        reply = self.echofi_ai.reply(
                            text
                        )
                    except Exception as e:
                        reply = (
                            f"[Echofi AI error] {e}"
                        )

                    self.last_ai_reply = reply

                    self._ui_log(
                        "Echofi: " + reply
                    )

                    self._set_status(
                        "🤖 Echofi ready"
                    )

                    if self.voice and self.voice.tts:
                        try:
                            self.voice.speak_async(
                                reply
                            )
                        except Exception:
                            pass

                thread(_ask)
            else:
                self._ui_log(
                    "[No peer and Echofi AI not configured]"
                )

    def _save_chat(self):
        data = self.chat_text.get(
            "1.0",
            "end-1c"
        )

        if not data.strip():
            messagebox.showinfo(
                "Save chat",
                "No messages to save."
            )
            return

        path = filedialog.asksaveasfilename(
            defaultextension=".txt",
            filetypes=[
                (
                    "Text files",
                    "*.txt"
                )
            ]
        )

        if not path:
            return

        try:
            with open(
                path,
                "w",
                encoding="utf-8"
            ) as f:
                f.write(data)

            self._ui_log(
                f"[Chat saved to {path}]"
            )

        except Exception as e:
            messagebox.showerror(
                "Save chat",
                f"Failed: {e}"
            )

    def _handle_disconnect_and_reconnect(self):
        try:
            with self.conn_lock:
                if self.conn:
                    try:
                        self.conn.close()
                    except Exception:
                        pass

                    self.conn = None
        except Exception:
            pass

        self.chat_mode = None

        self._set_status(
            "🔁 Reconnecting..."
        )

        def _retry():
            time.sleep(
                RECONNECT_DELAY
            )

            if self.autoconnector:
                self.autoconnector.trigger_scan_now()

        thread(_retry)

    def _on_close(self):
        self.running = False

        try:
            if self.camera:
                self.camera.stop()
        except Exception:
            pass

        try:
            if self.autoconnector:
                self.autoconnector.stop()
        except Exception:
            pass

        try:
            with self.conn_lock:
                if self.conn:
                    self.conn.close()
        except Exception:
            pass

        self.destroy()


class AutoConnector:
    def __init__(self, app, scan_interval=8):
        self.app = app
        self.scan_interval = scan_interval
        self.running = True
        self._scan_now = threading.Event()

        thread(
            self._watch_loop
        )

    def stop(self):
        self.running = False
        self._scan_now.set()

    def trigger_scan_now(self):
        self._scan_now.set()

    def _watch_loop(self):
        while self.running:
            try:
                if self.app.chat_mode != "peer":
                    self._discovery_cycle()
            except Exception as e:
                print(
                    "AutoConnector error:",
                    e
                )

            self._scan_now.wait(
                self.scan_interval
            )

            self._scan_now.clear()

    def _discovery_cycle(self):
        found_event = threading.Event()
        peer_holder = []

        thread(
            self._udp_listener,
            found_event,
            peer_holder
        )

        thread(
            self._udp_broadcaster,
            found_event
        )

        waited = 0.0
        timeout = 6.0

        while (
            not found_event.is_set()
            and waited < timeout
            and self.running
        ):
            time.sleep(0.2)
            waited += 0.2

        if found_event.is_set() and peer_holder:
            peer_ip = peer_holder[0]

            try:
                self.app._set_status(
                    f"🔗 Connecting to {peer_ip}..."
                )

                sock = socket.socket(
                    socket.AF_INET,
                    socket.SOCK_STREAM
                )

                sock.settimeout(
                    SOCKET_TIMEOUT
                )

                sock.connect(
                    (
                        peer_ip,
                        CHAT_PORT
                    )
                )

                self.app._bind_socket_as_client(
                    sock,
                    peer_ip
                )

                return

            except Exception as e:
                self.app._ui_log(
                    f"[AutoConnect] connect to "
                    f"{peer_ip} failed: {e}"
                )

        try:
            self.app._set_status(
                f"🟠 Hosting on port "
                f"{CHAT_PORT} (waiting)..."
            )

            serv = socket.socket(
                socket.AF_INET,
                socket.SOCK_STREAM
            )

            serv.setsockopt(
                socket.SOL_SOCKET,
                socket.SO_REUSEADDR,
                1
            )

            serv.bind(
                ("", CHAT_PORT)
            )

            serv.listen(1)
            serv.settimeout(6)

            try:
                conn, addr = serv.accept()

                self.app._bind_socket_as_client(
                    conn,
                    addr[0],
                    server_side=True
                )

                serv.close()
                return

            except socket.timeout:
                serv.close()

        except Exception as e:
            self.app._ui_log(
                f"[Hosting failed] {e}"
            )

        if self.app.echofi_ai:
            self.app._set_status(
                "🤖 Echofi ready (no peers)"
            )
        else:
            self.app._set_status(
                "Ready (no peers)"
            )

    def _udp_broadcaster(self, found_event):
        try:
            local_ip = get_local_ip()

            msg = (
                f"ECHOFI_DISCOVERY:{local_ip}"
            ).encode()

            s = socket.socket(
                socket.AF_INET,
                socket.SOCK_DGRAM
            )

            s.setsockopt(
                socket.SOL_SOCKET,
                socket.SO_BROADCAST,
                1
            )

            for _ in range(6):
                if (
                    found_event.is_set()
                    or not self.running
                ):
                    break

                s.sendto(
                    msg,
                    ("<broadcast>", BROADCAST_PORT)
                )

                time.sleep(
                    DISCOVER_INTERVAL
                )

            s.close()

        except Exception:
            pass

    def _udp_listener(
        self,
        found_event,
        peer_holder
    ):
        try:
            s = socket.socket(
                socket.AF_INET,
                socket.SOCK_DGRAM
            )

            s.setsockopt(
                socket.SOL_SOCKET,
                socket.SO_REUSEADDR,
                1
            )

            s.bind(
                ("", BROADCAST_PORT)
            )

            s.settimeout(1.0)

            local_ip = get_local_ip()
            start = time.time()

            while (
                not found_event.is_set()
                and time.time() - start < 6
                and self.running
            ):
                try:
                    data, addr = s.recvfrom(
                        2048
                    )

                    msg = data.decode(
                        errors="ignore"
                    )

                    if msg.startswith(
                        "ECHOFI_DISCOVERY:"
                    ):
                        peer_ip = msg.split(
                            ":",
                            1
                        )[1]

                        if peer_ip != local_ip:
                            peer_holder.append(
                                peer_ip
                            )

                            found_event.set()
                            break

                except socket.timeout:
                    continue

            s.close()

        except Exception:
            pass


def _recv_loop_factory(app, sock):
    def _recv_loop():
        try:
            sock.settimeout(
                SOCKET_TIMEOUT
            )

            while True:
                data = sock.recv(
                    BUFFER_SIZE
                )

                if not data:
                    raise ConnectionError(
                        "socket closed by peer"
                    )

                if data.startswith(
                    b"FILE|"
                ):
                    header = data

                    while b"\n" not in header:
                        more = sock.recv(
                            BUFFER_SIZE
                        )

                        if not more:
                            raise ConnectionError(
                                "socket closed while reading header"
                            )

                        header += more

                    header_line, rest = header.split(
                        b"\n",
                        1
                    )

                    try:
                        _, fname, szs = (
                            header_line
                            .decode("utf-8")
                            .split("|", 2)
                        )

                        size = int(szs)

                    except Exception:
                        app._ui_log(
                            "[File header parse error]"
                        )
                        continue

                    save_name = (
                        f"{int(time.time())}_"
                        f"{os.path.basename(fname)}"
                    )

                    save_path = os.path.join(
                        RECV_PHOTOS_DIR,
                        save_name
                    )

                    try:
                        with open(
                            save_path,
                            "wb"
                        ) as outf:

                            if rest:
                                outf.write(rest)
                                received = len(rest)
                            else:
                                received = 0

                            while received < size:
                                chunk = sock.recv(
                                    min(
                                        BUFFER_SIZE,
                                        size - received
                                    )
                                )

                                if not chunk:
                                    raise ConnectionError(
                                        "socket closed during file transfer"
                                    )

                                outf.write(chunk)
                                received += len(chunk)

                        app.last_received_photo = (
                            save_path
                        )

                        app._ui_log(
                            f"[Photo received: {save_path}]"
                        )

                    except Exception as e:
                        app._ui_log(
                            f"[File save error] {e}"
                        )

                    continue

                else:
                    try:
                        text = data.decode(
                            "utf-8",
                            errors="ignore"
                        )
                    except Exception:
                        continue

                    if text == "__typing__":
                        app._set_status(
                            "✍ Peer is typing..."
                        )

                        app.after(
                            2000,
                            lambda: app._set_status(
                                "🟢 Connected"
                                if app.conn
                                else "Ready"
                            )
                        )
                    else:
                        app._ui_log(
                            "Peer: " + text
                        )

                        if app.voice and app.voice.tts:
                            app.voice.speak_async(
                                text
                            )

        except Exception as e:
            app._ui_log(
                f"[Peer connection closed: {e}]"
            )

        finally:
            try:
                with app.conn_lock:
                    try:
                        sock.close()
                    except Exception:
                        pass

                    if app.conn is sock:
                        app.conn = None

            except Exception:
                pass

            app.chat_mode = None

            app._set_status(
                "🔁 Reconnecting..."
            )

            if app.autoconnector:
                app.autoconnector.trigger_scan_now()

    return _recv_loop


def _bind_socket_as_client(
    self,
    sock,
    peer_ip,
    server_side=False
):
    with self.conn_lock:
        try:
            if self.conn:
                try:
                    self.conn.close()
                except Exception:
                    pass
        except Exception:
            pass

        self.conn = sock
        self.server_side = server_side
        self.chat_mode = "peer"

    self._set_status(
        f"🟢 Connected to {peer_ip}"
    )

    self._ui_log(
        f"[Peer connected: {peer_ip}]"
    )

    recv_loop = _recv_loop_factory(
        self,
        sock
    )

    thread(recv_loop)


EchofiApp._bind_socket_as_client = (
    _bind_socket_as_client
)


def main():
    app = EchofiApp()
    app.mainloop()


if __name__ == "__main__":
    main()
