def thread(fn, *a, **kw):
    t = threading.Thread(target=fn, args=a, kwargs=kw, daemon=True)
    t.start()
    return t


def now_ts():
    return datetime.now().strftime("%H:%M:%S")


def get_local_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except Exception:
        return "127.0.0.1"


class EchofiAI:
    def __init__(self, api_key, model=ECHOFI_MODEL):
        if genai is None:
            raise RuntimeError("google-generativeai not installed")
        genai.configure(api_key=api_key)
        self.model = genai.GenerativeModel(model)

    def reply(self, prompt: str) -> str:
        r = self.model.generate_content(prompt)
        return getattr(r, "text", str(r))


class VoiceEngine:
    def __init__(self):
        self.recognizer = sr.Recognizer() if sr else None
        self.tts = None

        if pyttsx3:
            try:
                self.tts = pyttsx3.init()
            except Exception:
                self.tts = None

    def listen_once(self, timeout=5, phrase_time_limit=8):
        if not self.recognizer:
            raise RuntimeError("SpeechRecognition not available")

        with sr.Microphone() as mic:
            self.recognizer.adjust_for_ambient_noise(mic, duration=0.4)
            audio = self.recognizer.listen(
                mic,
                timeout=timeout,
                phrase_time_limit=phrase_time_limit
            )

        return self.recognizer.recognize_google(audio)

    def speak_async(self, text):
        if not self.tts:
            return False

        def _run():
            try:
                self.tts.say(text)
                self.tts.runAndWait()
            except Exception:
                pass

        thread(_run)
        return True


class CameraHelper:
    def __init__(self, device=0):
        self.device = device
        self.cap = None
        self.running = False
        self.frame = None

    def start(self):
        if cv2 is None:
            raise RuntimeError("OpenCV not installed")

        if self.running:
            return

        try:
            if sys.platform.startswith("win"):
                self.cap = cv2.VideoCapture(self.device, cv2.CAP_DSHOW)
            else:
                self.cap = cv2.VideoCapture(self.device)
        except Exception:
            self.cap = cv2.VideoCapture(self.device)

        if not self.cap or not self.cap.isOpened():
            raise RuntimeError("Could not open camera")

        self.running = True
        thread(self._loop)

    def _loop(self):
        while self.running and self.cap and self.cap.isOpened():
            ok, frm = self.cap.read()

            if ok:
                self.frame = frm

            time.sleep(0.02)

        try:
            if self.cap:
                self.cap.release()
        except Exception:
            pass

        self.running = False

    def stop(self):
        self.running = False

    def get_tk_image(self, maxsize=(320, 240)):
        if self.frame is None or Image is None:
            return None

        import cv2 as _cv

        rgb = _cv.cvtColor(self.frame, _cv.COLOR_BGR2RGB)
        pil = Image.fromarray(rgb)
        pil.thumbnail(maxsize)

        return ImageTk.PhotoImage(pil)

    def take_photo(self, filename):
        if self.frame is None:
            raise RuntimeError("No frame available")

        import cv2 as _cv

        _cv.imwrite(filename, self.frame)
        return filename


